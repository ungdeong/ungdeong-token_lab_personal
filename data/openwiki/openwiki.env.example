# OpenWiki 설정 (팀 Ollama 서버)
# 이 파일을 data/openwiki/config/.env 로 복사해 값을 채운다 (config/ 는 git 에 올리지 않음).
# 실행 전 OPENWIKI_CONFIG_DIR 를 data/openwiki/config 로 지정해야 이 설정을 읽는다.

OPENWIKI_PROVIDER=openai-compatible
# 팀 서버 주소. 끝에 /v1 을 붙인다
OPENAI_COMPATIBLE_BASE_URL=http://<팀서버 주소>:11434/v1
# Ollama 는 키를 검사하지 않지만 값이 비어 있으면 안 된다
OPENAI_COMPATIBLE_API_KEY=ollama
# 도구 호출(tool calling)을 지원하는 모델이어야 한다. 14B 이상 권장
OPENWIKI_MODEL_ID=qwen2.5:14b

OPENWIKI_TELEMETRY_DISABLED=1
# 페이지 병렬 작성 수. 서버가 한 번에 한 요청만 처리하면 1
OPENWIKI_PAGE_CONCURRENCY=1
OPENWIKI_PROVIDER_RETRY_ATTEMPTS=3
OPENWIKI_MAX_OUTPUT_TOKENS=8192
